# Local development with an embedded PostgreSQL database
PGLITE_PATH=./.smarterp-data
# For hosted or local PostgreSQL, configure the server connection URL instead.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PORT=5000
FRONTEND_URL=http://localhost:3000
# Generate a random value as shown in the README.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Password recovery email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
